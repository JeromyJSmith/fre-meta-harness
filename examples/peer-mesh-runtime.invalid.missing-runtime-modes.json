{
  "schema_version": "1.0.0",
  "contract_id": "parent-peer-mesh-runtime",
  "scope": "portable_parent_wrapper",
  "actors": {
    "required_roles": [
      "peer_mesh_host",
      "prod_gatekeeper",
      "dev_driver",
      "mesh_verifier"
    ],
    "prod_boundary_role": "prod_gatekeeper",
    "verification_role": "mesh_verifier"
  },
  "completion_boundary": {
    "await_response_required": true,
    "required_completion_tokens": [
      "done",
      "failed",
      "needs-human"
    ],
    "max_loop_budget_per_scenario": 8,
    "max_retries_per_message": 2,
    "lifecycle_contract": "contracts/peer-lifecycle.yaml"
  }
}
