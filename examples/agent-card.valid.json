{
  "schema_version": "1.0.0",
  "artifact_type": "agent_card",
  "agent_id": "capability-harvester-agent",
  "tool_id": "capability-harvester",
  "name": "Capability Harvester Agent",
  "description": "Discovers, validates, and emits schema-backed capability harvest artifacts for parent-owned workflow slices.",
  "owner": "research",
  "discovery": {
    "path": "/.well-known/agent.json",
    "method": "GET",
    "returned_artifact_type": "agent_card"
  },
  "capabilities": [
    "CAP-0001",
    "CAP-0006",
    "CAP-0007"
  ],
  "input_modalities": [
    "json",
    "markdown",
    "path_refs"
  ],
  "output_artifact_types": [
    "compiled_feature_matrix",
    "tool_artifact"
  ],
  "task_endpoints": {
    "create": "/v1/tools/{toolId}/tasks",
    "status": "/v1/tasks/{taskId}",
    "artifacts": "/v1/tasks/{taskId}/artifacts"
  },
  "policy_modes": [
    "allow",
    "block",
    "ask"
  ],
  "observability_contract_ref": "contracts/observability-ingest.yaml"
}
