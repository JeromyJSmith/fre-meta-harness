{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-harness.local/schemas/agent-heavy-run-prompt.schema.json",
  "title": "Agent Heavy Run Prompt Schema",
  "description": "Machine-readable schema for bounded heavy-run execution prompts usable across parent and child wrappers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prompt_schema_version",
    "prompt_id",
    "target_agent",
    "triad_context",
    "mode",
    "mission",
    "current_verified_state",
    "hard_rules",
    "allowed_paths",
    "disallowed_paths",
    "tasks",
    "validation_loop",
    "handoff_inputs",
    "success_criteria",
    "report_contract"
  ],
  "properties": {
    "prompt_schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "prompt_id": {
      "type": "string",
      "pattern": "^PROMPT-[0-9]{8}-[A-Z0-9]{4,}$"
    },
    "target_agent": {
      "$ref": "#/$defs/target_agent"
    },
    "triad_context": {
      "$ref": "#/$defs/triad_context"
    },
    "mode": {
      "$ref": "#/$defs/mode"
    },
    "mission": {
      "$ref": "#/$defs/mission"
    },
    "current_verified_state": {
      "$ref": "#/$defs/current_verified_state"
    },
    "hard_rules": {
      "$ref": "#/$defs/hard_rules"
    },
    "allowed_paths": {
      "$ref": "#/$defs/path_list"
    },
    "disallowed_paths": {
      "$ref": "#/$defs/path_list"
    },
    "tasks": {
      "$ref": "#/$defs/tasks"
    },
    "validation_loop": {
      "$ref": "#/$defs/validation_loop"
    },
    "handoff_inputs": {
      "$ref": "#/$defs/handoff_inputs"
    },
    "success_criteria": {
      "$ref": "#/$defs/success_criteria"
    },
    "report_contract": {
      "$ref": "#/$defs/report_contract"
    }
  },
  "$defs": {
    "string_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "target_agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "surface",
        "invocation"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "invocation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "governed_role_id": {
      "type": "string",
      "enum": [
        "orchestrator-validator",
        "research",
        "architect"
      ]
    },
    "runtime_role_id": {
      "type": "string",
      "enum": [
        "user-facing-agent",
        "spec-interpreter",
        "filesystem-router",
        "intake-mapper",
        "semantic-cartographer",
        "wrapper-synthesizer"
      ]
    },
    "governed_or_runtime_role_id": {
      "type": "string",
      "enum": [
        "orchestrator-validator",
        "research",
        "architect",
        "user-facing-agent",
        "spec-interpreter",
        "filesystem-router",
        "intake-mapper",
        "semantic-cartographer",
        "wrapper-synthesizer"
      ]
    },
    "packet_artifact_type": {
      "type": "string",
      "enum": [
        ".brainstorm.md",
        ".plan.md",
        ".analysis.md",
        ".test.md",
        ".review.md",
        ".handoff.md",
        ".spec.md",
        ".checkpoint.md"
      ]
    },
    "triad_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acting_role",
        "upstream_handoff_ref",
        "upstream_inbox_packet_ref",
        "packet_artifact_type",
        "required_gate_state",
        "required_consumers",
        "bottom_matter_ref",
        "structured_contract_ref",
        "decision_space_required",
        "runtime_truth_requirements",
        "command_evidence_requirements"
      ],
      "properties": {
        "acting_role": {
          "$ref": "#/$defs/governed_or_runtime_role_id"
        },
        "upstream_handoff_ref": {
          "type": "string",
          "minLength": 1
        },
        "upstream_inbox_packet_ref": {
          "type": "string",
          "minLength": 1
        },
        "packet_artifact_type": {
          "$ref": "#/$defs/packet_artifact_type"
        },
        "required_gate_state": {
          "type": "string",
          "enum": ["green", "amber"]
        },
        "required_consumers": {
          "$ref": "#/$defs/string_list"
        },
        "bottom_matter_ref": {
          "type": "string",
          "minLength": 1
        },
        "structured_contract_ref": {
          "type": "string",
          "minLength": 1
        },
        "decision_space_required": {
          "type": "boolean",
          "const": true
        },
        "runtime_truth_requirements": {
          "$ref": "#/$defs/string_list"
        },
        "command_evidence_requirements": {
          "$ref": "#/$defs/string_list"
        },
        "agent_extension_request_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_style",
        "autonomy",
        "permission_model"
      ],
      "properties": {
        "execution_style": {
          "type": "string",
          "enum": [
            "heavy_bounded_run",
            "bounded_run",
            "diagnostic_run"
          ]
        },
        "autonomy": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "permission_model": {
          "type": "string",
          "enum": [
            "no_intermediate_permission",
            "ask_when_blocked",
            "stepwise"
          ]
        }
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "repo_scope",
        "task_scope"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "repo_scope": {
          "type": "string",
          "minLength": 1
        },
        "task_scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "current_verified_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facts"
      ],
      "properties": {
        "facts": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "hard_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "safety",
        "truthfulness"
      ],
      "properties": {
        "environment": {
          "$ref": "#/$defs/string_list"
        },
        "safety": {
          "$ref": "#/$defs/string_list"
        },
        "truthfulness": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "path_list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paths"
      ],
      "properties": {
        "paths": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordered_steps"
      ],
      "properties": {
        "ordered_steps": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "validation_loop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks",
        "rerun_policy"
      ],
      "properties": {
        "checks": {
          "$ref": "#/$defs/string_list"
        },
        "rerun_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "handoff_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff_artifact_path",
        "source_report_paths",
        "required_follow_up_roles",
        "consumption_requirements"
      ],
      "properties": {
        "handoff_artifact_path": {
          "type": "string",
          "minLength": 1
        },
        "source_report_paths": {
          "$ref": "#/$defs/string_list"
        },
        "required_follow_up_roles": {
          "$ref": "#/$defs/string_list"
        },
        "consumption_requirements": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "success_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "best_case",
        "acceptable_fallback"
      ],
      "properties": {
        "best_case": {
          "type": "string",
          "minLength": 1
        },
        "acceptable_fallback": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "report_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_fields",
        "runtime_truth_fields",
        "blocker_fields",
        "freshness_fields",
        "score_saturation_fields",
        "command_evidence_fields",
        "follow_up_prompt_fields"
      ],
      "properties": {
        "required_fields": {
          "$ref": "#/$defs/string_list"
        },
        "runtime_truth_fields": {
          "$ref": "#/$defs/string_list"
        },
        "blocker_fields": {
          "$ref": "#/$defs/string_list"
        },
        "freshness_fields": {
          "$ref": "#/$defs/string_list"
        },
        "score_saturation_fields": {
          "$ref": "#/$defs/string_list"
        },
        "command_evidence_fields": {
          "$ref": "#/$defs/string_list"
        },
        "follow_up_prompt_fields": {
          "$ref": "#/$defs/string_list"
        }
      }
    }
  }
}
