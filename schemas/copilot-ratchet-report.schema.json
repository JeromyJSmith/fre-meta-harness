{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-harness.local/schemas/copilot-ratchet-report.schema.json",
  "title": "Parent Copilot Ratchet Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "metric_decision",
    "metric_reason",
    "metric_review",
    "real_non_dry_cycles_executed",
    "stop_reason",
    "stop_evidence",
    "score_history",
    "runtime_truth",
    "score_saturation",
    "files_changed",
    "artifacts",
    "iteration_ledger_entries_appended"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["running", "pass", "blocked"]
    },
    "metric_decision": {
      "type": "string",
      "enum": ["accepted", "repaired"]
    },
    "metric_reason": {
      "type": "string",
      "minLength": 1
    },
    "metric_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_total_score",
        "baseline_outcome_score",
        "baseline_instrument_score",
        "final_total_score",
        "final_outcome_score",
        "final_instrument_score",
        "trustworthy",
        "trust_signals",
        "problems_found",
        "repair_actions"
      ],
      "properties": {
        "baseline_total_score": {
          "type": "number"
        },
        "baseline_outcome_score": {
          "type": "number"
        },
        "baseline_instrument_score": {
          "type": "number"
        },
        "final_total_score": {
          "type": "number"
        },
        "final_outcome_score": {
          "type": "number"
        },
        "final_instrument_score": {
          "type": "number"
        },
        "trustworthy": {
          "type": "boolean"
        },
        "trust_signals": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "problems_found": {
          "$ref": "#/$defs/string_array"
        },
        "repair_actions": {
          "$ref": "#/$defs/string_array"
        }
      }
    },
    "real_non_dry_cycles_executed": {
      "type": "integer",
      "minimum": 0
    },
    "stop_reason": {
      "type": "string",
      "minLength": 1
    },
    "stop_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["continuing", "plateau", "blocker"]
        },
        "consecutive_non_improving_cycles": {
          "type": "integer",
          "minimum": 0
        },
        "blocker_details": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "plateau"
              }
            }
          },
          "then": {
            "required": ["consecutive_non_improving_cycles"],
            "properties": {
              "consecutive_non_improving_cycles": {
                "minimum": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "blocker"
              }
            }
          },
          "then": {
            "required": ["blocker_details"],
            "properties": {
              "blocker_details": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "score_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cycle",
          "before_total_score",
          "after_total_score",
          "before_outcome_score",
          "after_outcome_score",
          "before_instrument_score",
          "after_instrument_score",
          "changed_files",
          "kept",
          "summary"
        ],
        "properties": {
          "cycle": {
            "type": "integer",
            "minimum": 1
          },
          "before_total_score": {
            "type": "number"
          },
          "after_total_score": {
            "type": "number"
          },
          "before_outcome_score": {
            "type": "number"
          },
          "after_outcome_score": {
            "type": "number"
          },
          "before_instrument_score": {
            "type": "number"
          },
          "after_instrument_score": {
            "type": "number"
          },
          "changed_files": {
            "$ref": "#/$defs/non_empty_string_array"
          },
          "kept": {
            "type": "boolean"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "runtime_truth": {
      "$ref": "#/$defs/runtime_truth"
    },
    "score_saturation": {
      "$ref": "#/$defs/score_saturation"
    },
    "files_changed": {
      "$ref": "#/$defs/non_empty_string_array"
    },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "iteration_ledger_entries_appended": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifact_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "observed_at"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "command_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "exit_code",
        "evidence_refs",
        "bounded_scope_note"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer"
        },
        "evidence_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "bounded_scope_note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mismatch_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mismatch_id",
        "classification",
        "baseline_gap",
        "kept_resolution",
        "evidence_refs"
      ],
      "properties": {
        "mismatch_id": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "baseline_gap": {
          "type": "string",
          "minLength": 1
        },
        "kept_resolution": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      }
    },
    "blocked_lane_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_id",
        "classification",
        "status",
        "blocker_dependency",
        "missing_prerequisites",
        "evidence_refs",
        "exactness_reason"
      ],
      "properties": {
        "lane_id": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "blocker_dependency": {
          "type": "string",
          "minLength": 1
        },
        "missing_prerequisites": {
          "$ref": "#/$defs/string_array"
        },
        "evidence_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "exactness_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtime_mode_blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode_id",
        "status",
        "blocker_dependency",
        "missing_prerequisites",
        "evidence_refs",
        "exactness_reason"
      ],
      "properties": {
        "mode_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "blocker_dependency": {
          "type": "string",
          "minLength": 1
        },
        "missing_prerequisites": {
          "$ref": "#/$defs/string_array"
        },
        "evidence_refs": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "exactness_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtime_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truth_level",
        "runtime_modes_blocked",
        "activation_artifacts",
        "observability_artifacts",
        "tool_health_evidence",
        "completion_tokens_required",
        "completion_tokens_observed",
        "policy_outcomes_observed",
        "mismatch_list",
        "blocked_lanes",
        "command_evidence",
        "freshness"
      ],
      "properties": {
        "truth_level": {
          "type": "string",
          "enum": ["contract_only", "bounded_runtime", "active_runtime"]
        },
        "runtime_mode_activated": {
          "type": "string",
          "minLength": 1
        },
        "runtime_modes_blocked": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runtime_mode_blocker"
          }
        },
        "activation_artifacts": {
          "$ref": "#/$defs/string_array"
        },
        "observability_artifacts": {
          "$ref": "#/$defs/string_array"
        },
        "tool_health_evidence": {
          "$ref": "#/$defs/string_array"
        },
        "completion_tokens_required": {
          "$ref": "#/$defs/string_array"
        },
        "completion_tokens_observed": {
          "$ref": "#/$defs/string_array"
        },
        "policy_outcomes_observed": {
          "$ref": "#/$defs/string_array"
        },
        "mismatch_list": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mismatch_record"
          }
        },
        "blocked_lanes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blocked_lane_record"
          }
        },
        "command_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "activation_commands",
            "validation_commands",
            "tool_health_commands"
          ],
          "properties": {
            "activation_commands": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/command_record"
              }
            },
            "validation_commands": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/command_record"
              }
            },
            "tool_health_commands": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/command_record"
              }
            }
          }
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_records",
            "max_artifact_span_seconds"
          ],
          "properties": {
            "artifact_records": {
              "type": "array",
              "minItems": 4,
              "items": {
                "$ref": "#/$defs/artifact_record"
              }
            },
            "max_artifact_span_seconds": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "truth_level": {
                "enum": ["bounded_runtime", "active_runtime"]
              }
            }
          },
          "then": {
            "required": [
              "runtime_mode_activated"
            ],
            "properties": {
              "activation_artifacts": {
                "minItems": 1
              },
              "observability_artifacts": {
                "minItems": 1
              },
              "tool_health_evidence": {
                "minItems": 1
              },
              "completion_tokens_required": {
                "minItems": 1
              },
              "completion_tokens_observed": {
                "minItems": 1
              },
              "policy_outcomes_observed": {
                "minItems": 1
              },
              "mismatch_list": {
                "minItems": 1
              },
              "blocked_lanes": {
                "minItems": 1
              },
              "command_evidence": {
                "properties": {
                  "activation_commands": {
                    "minItems": 1
                  },
                  "validation_commands": {
                    "minItems": 1
                  },
                  "tool_health_commands": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "score_saturation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_total_score",
        "final_total_score",
        "baseline_outcome_score",
        "final_outcome_score",
        "baseline_instrument_score",
        "final_instrument_score",
        "score_changed",
        "new_truth_added",
        "why_this_slice_counts"
      ],
      "properties": {
        "baseline_total_score": {
          "type": "number"
        },
        "final_total_score": {
          "type": "number"
        },
        "baseline_outcome_score": {
          "type": "number"
        },
        "final_outcome_score": {
          "type": "number"
        },
        "baseline_instrument_score": {
          "type": "number"
        },
        "final_instrument_score": {
          "type": "number"
        },
        "score_changed": {
          "type": "boolean"
        },
        "new_truth_added": {
          "type": "string",
          "minLength": 1
        },
        "why_this_slice_counts": {
          "type": "string",
          "minLength": 1
        },
        "flat_score_explanation": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "score_changed": {
                "const": false
              }
            }
          },
          "then": {
            "required": [
              "flat_score_explanation"
            ]
          }
        }
      ]
    }
  }
}
