{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-harness.local/schemas/copilot-ratchet-report.schema.json",
  "title": "Parent Copilot Ratchet Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "metric_decision",
    "metric_reason",
    "metric_review",
    "real_non_dry_cycles_executed",
    "stop_reason",
    "stop_evidence",
    "score_history",
    "files_changed",
    "artifacts",
    "iteration_ledger_entries_appended"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["running", "pass", "blocked"]
    },
    "metric_decision": {
      "type": "string",
      "enum": ["accepted", "repaired"]
    },
    "metric_reason": {
      "type": "string",
      "minLength": 1
    },
    "metric_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_total_score",
        "baseline_outcome_score",
        "baseline_instrument_score",
        "trustworthy",
        "trust_signals",
        "problems_found",
        "repair_actions"
      ],
      "properties": {
        "baseline_total_score": {
          "type": "number"
        },
        "baseline_outcome_score": {
          "type": "number"
        },
        "baseline_instrument_score": {
          "type": "number"
        },
        "trustworthy": {
          "type": "boolean"
        },
        "trust_signals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "problems_found": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "repair_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "real_non_dry_cycles_executed": {
      "type": "integer",
      "minimum": 0
    },
    "stop_reason": {
      "type": "string",
      "minLength": 1
    },
    "stop_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["continuing", "plateau", "blocker"]
        },
        "consecutive_non_improving_cycles": {
          "type": "integer",
          "minimum": 0
        },
        "blocker_details": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "plateau"
              }
            }
          },
          "then": {
            "required": ["consecutive_non_improving_cycles"],
            "properties": {
              "consecutive_non_improving_cycles": {
                "minimum": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "blocker"
              }
            }
          },
          "then": {
            "required": ["blocker_details"],
            "properties": {
              "blocker_details": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "score_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cycle",
          "before_total_score",
          "after_total_score",
          "before_outcome_score",
          "after_outcome_score",
          "before_instrument_score",
          "after_instrument_score",
          "changed_files",
          "kept",
          "summary"
        ],
        "properties": {
          "cycle": {
            "type": "integer",
            "minimum": 1
          },
          "before_total_score": {
            "type": "number"
          },
          "after_total_score": {
            "type": "number"
          },
          "before_outcome_score": {
            "type": "number"
          },
          "after_outcome_score": {
            "type": "number"
          },
          "before_instrument_score": {
            "type": "number"
          },
          "after_instrument_score": {
            "type": "number"
          },
          "changed_files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "kept": {
            "type": "boolean"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "files_changed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "iteration_ledger_entries_appended": {
      "type": "integer",
      "minimum": 0
    }
  }
}
