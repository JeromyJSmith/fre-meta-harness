{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fre-meta-harness/schemas/subsystem-registry-record.schema.json",
  "title": "Subsystem Registry Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "registry_id",
    "scope",
    "topology_ref",
    "registry_contract_ref",
    "authoritative_root",
    "runtime_truth",
    "subsystems",
    "repo_catalog",
    "reusable_infrastructure_shortlist"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "subsystem_registry_record"
    },
    "registry_id": {
      "type": "string",
      "pattern": "^SUBSYSREG-[0-9]{8}-[A-Z0-9]{4,}$"
    },
    "scope": {
      "type": "string",
      "const": "portable_parent_wrapper"
    },
    "topology_ref": {
      "type": "string",
      "const": "contracts/subsystem-harness-topology.yaml"
    },
    "registry_contract_ref": {
      "type": "string",
      "const": "contracts/subsystem-registry.yaml"
    },
    "authoritative_root": {
      "type": "string",
      "const": "source/subsystems"
    },
    "runtime_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_truth_level",
        "active_parent_runtime_lanes",
        "blocked_parent_runtime_lanes",
        "activation_commands",
        "validation_commands",
        "activation_artifacts_used",
        "non_activated_subsystem_lanes",
        "do_not_overclaim_notes"
      ],
      "properties": {
        "runtime_truth_level": {
          "type": "string",
          "enum": [
            "contract_only",
            "bounded_runtime",
            "active_runtime"
          ]
        },
        "active_parent_runtime_lanes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "peer_mesh_local.same_host",
              "inbox_protocol.same_host"
            ]
          }
        },
        "blocked_parent_runtime_lanes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/blockedRuntimeLane"
          }
        },
        "activation_commands": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation_commands": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "activation_artifacts_used": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "non_activated_subsystem_lanes": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/subsystemId"
          }
        },
        "do_not_overclaim_notes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "subsystems": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/subsystemRecord"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "subsystem_id": {
                "const": "intake_etl"
              }
            },
            "required": [
              "subsystem_id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "subsystem_id": {
                "const": "research_harvest"
              }
            },
            "required": [
              "subsystem_id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "subsystem_id": {
                "const": "semantic_cartography"
              }
            },
            "required": [
              "subsystem_id"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "subsystem_id": {
                "const": "wrapper_synthesizer"
              }
            },
            "required": [
              "subsystem_id"
            ]
          }
        }
      ]
    },
    "repo_catalog": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/repoEntry"
      }
    },
    "reusable_infrastructure_shortlist": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/shortlistEntry"
      }
    }
  },
  "$defs": {
    "subsystemId": {
      "type": "string",
      "enum": [
        "intake_etl",
        "research_harvest",
        "semantic_cartography",
        "wrapper_synthesizer"
      ]
    },
    "fitArea": {
      "type": "string",
      "enum": [
        "intake_etl",
        "research_harvest",
        "semantic_cartography",
        "wrapper_synthesizer",
        "observability",
        "durable_execution",
        "spec_compiler",
        "substrate_sync"
      ]
    },
    "classification": {
      "type": "string",
      "enum": [
        "core",
        "gated",
        "deployment_specific",
        "reference",
        "blocked_with_exact_dependency"
      ]
    },
    "activationState": {
      "type": "string",
      "enum": [
        "defined_not_activated",
        "late_bound_not_activated"
      ]
    },
    "blockedRuntimeLane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_id",
        "classification",
        "blocker_dependency",
        "evidence_refs"
      ],
      "properties": {
        "lane_id": {
          "type": "string",
          "enum": [
            "peer_mesh_local.cross_device",
            "inbox_protocol.cross_device"
          ]
        },
        "classification": {
          "type": "string",
          "const": "blocked_with_exact_dependency"
        },
        "blocker_dependency": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "subsystemRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subsystem_id",
        "lane_classification",
        "activation_state",
        "wrap_boundary",
        "authoritative_scaffold_refs",
        "consumes",
        "emits",
        "reusable_infrastructure_refs",
        "blocked_by",
        "notes"
      ],
      "properties": {
        "subsystem_id": {
          "$ref": "#/$defs/subsystemId"
        },
        "lane_classification": {
          "$ref": "#/$defs/classification"
        },
        "activation_state": {
          "$ref": "#/$defs/activationState"
        },
        "wrap_boundary": {
          "type": "string",
          "minLength": 1
        },
        "authoritative_scaffold_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "consumes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "emits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reusable_infrastructure_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blocked_by": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repoEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_id",
        "classification",
        "best_fit_subsystems",
        "reusable_now",
        "exact_dependency_or_limit",
        "why",
        "source_refs"
      ],
      "properties": {
        "repo_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "best_fit_subsystems": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fitArea"
          }
        },
        "reusable_now": {
          "type": "boolean"
        },
        "exact_dependency_or_limit": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "shortlistEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_id",
        "fit_areas",
        "why_now",
        "reusable_surfaces",
        "source_refs"
      ],
      "properties": {
        "repo_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "fit_areas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fitArea"
          }
        },
        "why_now": {
          "type": "string",
          "minLength": 1
        },
        "reusable_surfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
