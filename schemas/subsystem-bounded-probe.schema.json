{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fre-meta-harness/schemas/subsystem-bounded-probe.schema.json",
  "title": "Subsystem Bounded Probe Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "scope",
    "family_contract_ref",
    "truth_boundary",
    "proof_state_vocabulary",
    "probe_requirements",
    "subsystem_probe_designs"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "contract_id": {
      "type": "string",
      "const": "parent-subsystem-bounded-probe"
    },
    "scope": {
      "type": "string",
      "const": "portable_parent_wrapper"
    },
    "family_contract_ref": {
      "type": "string",
      "const": "contracts/subsystem-runner-proof-family.yaml"
    },
    "truth_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_parent_runtime_lanes",
        "blocked_parent_runtime_lanes",
        "no_child_runtime_adoption_claims",
        "no_pixeltable_or_duckdb_activation_claims"
      ],
      "properties": {
        "allowed_parent_runtime_lanes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "peer_mesh_local.same_host",
              "inbox_protocol.same_host"
            ]
          }
        },
        "blocked_parent_runtime_lanes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "peer_mesh_local.cross_device",
              "inbox_protocol.cross_device"
            ]
          }
        },
        "no_child_runtime_adoption_claims": {
          "type": "boolean",
          "const": true
        },
        "no_pixeltable_or_duckdb_activation_claims": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "proof_state_vocabulary": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proof_state",
          "meaning",
          "transition_rule"
        ],
        "properties": {
          "proof_state": {
            "type": "string",
            "enum": [
              "designed_not_activated",
              "bounded_probe_blocked",
              "bounded_probe_pass",
              "activation_proven_same_host"
            ]
          },
          "meaning": {
            "type": "string",
            "minLength": 20
          },
          "transition_rule": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    },
    "probe_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "designed_not_activated_rule",
        "same_host_only_rule",
        "required_validation_commands",
        "required_graph_analysis_commands",
        "required_artifact_classes"
      ],
      "properties": {
        "designed_not_activated_rule": {
          "type": "string",
          "minLength": 20
        },
        "same_host_only_rule": {
          "type": "string",
          "minLength": 20
        },
        "required_validation_commands": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "required_graph_analysis_commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "required_artifact_classes": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "subsystem_probe_designs": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/probeDesign"
      }
    }
  },
  "$defs": {
    "subsystemId": {
      "type": "string",
      "enum": [
        "intake_etl",
        "research_harvest",
        "semantic_cartography",
        "wrapper_synthesizer"
      ]
    },
    "probeDesign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subsystem_id",
        "execution_status",
        "designed_probe_mode",
        "planned_inputs",
        "planned_outputs",
        "missing_prerequisites",
        "proof_boundary_notes"
      ],
      "properties": {
        "subsystem_id": {
          "$ref": "#/$defs/subsystemId"
        },
        "execution_status": {
          "type": "string",
          "const": "designed_not_activated"
        },
        "designed_probe_mode": {
          "type": "string",
          "minLength": 3
        },
        "planned_inputs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "planned_outputs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "missing_prerequisites": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 10
          }
        },
        "proof_boundary_notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 15
          }
        }
      }
    }
  }
}
