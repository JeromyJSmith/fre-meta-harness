{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fre-meta-harness/schemas/agent-role-contract.schema.json",
  "title": "Parent Agent Role Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "scope",
    "governing_contracts",
    "roles"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "contract_id": {
      "type": "string",
      "const": "parent-agent-role-contract"
    },
    "scope": {
      "type": "string",
      "const": "portable_parent_wrapper"
    },
    "governing_contracts": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "roles": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/role"
      }
    }
  },
  "$defs": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_id",
        "role_class",
        "purpose",
        "owned_lane",
        "inputs",
        "outputs",
        "permissions",
        "tool_refs",
        "skill_refs",
        "hook_refs",
        "runtime_modes",
        "message_operations",
        "handoff_targets",
        "escalation",
        "verification_boundary"
      ],
      "properties": {
        "role_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_\\-]+$"
        },
        "role_class": {
          "type": "string",
          "minLength": 3
        },
        "purpose": {
          "type": "string",
          "minLength": 20
        },
        "owned_lane": {
          "type": "string",
          "minLength": 3
        },
        "inputs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "can_send_prompt",
            "can_send_command",
            "can_access_prod",
            "requires_pii_redaction"
          ],
          "properties": {
            "can_send_prompt": {
              "type": "boolean"
            },
            "can_send_command": {
              "type": "boolean"
            },
            "can_access_prod": {
              "type": "boolean"
            },
            "requires_pii_redaction": {
              "type": "boolean"
            }
          }
        },
        "tool_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "skill_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "hook_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "runtime_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["same_host", "cross_device"]
          }
        },
        "message_operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_\\-]+$"
          }
        },
        "handoff_targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_\\-]+$"
          }
        },
        "escalation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "on_loop_budget_exceeded",
            "on_completion_ambiguity"
          ],
          "properties": {
            "on_loop_budget_exceeded": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_\\-]+$"
            },
            "on_completion_ambiguity": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_\\-]+$"
            }
          }
        },
        "verification_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "completion_token_required",
            "failure_mode",
            "policy_decision_required",
            "observability_event_required"
          ],
          "properties": {
            "completion_token_required": {
              "type": "boolean",
              "const": true
            },
            "failure_mode": {
              "type": "string",
              "const": "fail_loud"
            },
            "policy_decision_required": {
              "type": "boolean",
              "const": true
            },
            "observability_event_required": {
              "type": "boolean",
              "const": true
            }
          }
        }
      }
    }
  }
}
