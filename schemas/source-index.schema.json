{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fre-meta-harness/schemas/source-index.schema.json",
  "title": "Compiled Source Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_type",
    "status",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "packet_type": {
      "type": "string",
      "enum": ["source_index", "compiled_source_index"]
    },
    "status": {
      "type": "string",
      "enum": ["fresh", "refreshed"]
    },
    "generated_at": {
      "type": "string"
    },
    "sources": {
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceEntry"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "oneOf": [
                {"type": "string"},
                {"type": "object"}
              ]
            }
          }
        }
      ]
    },
    "source_catalog": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "oneOf": [
            {"type": "string"},
            {"type": "object"}
          ]
        }
      }
    },
    "lib_repos": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "totals": {
      "type": "object"
    }
  },
  "$defs": {
    "evidenceStrength": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "evidence_type",
        "strength_class",
        "transcript_derived",
        "workflow_claim_promotion",
        "notes"
      ],
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 3
        },
        "evidence_type": {
          "type": "string"
        },
        "strength_class": {
          "type": "string"
        },
        "transcript_derived": {
          "type": "boolean"
        },
        "workflow_claim_promotion": {
          "type": "string",
          "enum": ["allowed", "blocked"]
        },
        "required_artifacts": {
          "type": "array",
          "items": {"type": "string"}
        },
        "do_not_promote_reason": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "sourceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "evidence_type",
        "evidence_strength",
        "used_by_packets",
        "notes"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "local_notion_doc",
            "github_readme",
            "github_file",
            "parent_contract",
            "consume_packet"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 3
        },
        "evidence_type": {
          "type": "string"
        },
        "evidence_strength": {
          "$ref": "#/$defs/evidenceStrength"
        },
        "video_evidence_strength": {
          "type": "string"
        },
        "used_by_packets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    }
  }
}
