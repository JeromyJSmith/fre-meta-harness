{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fre-meta-harness/schemas/front-door-runtime-topology.schema.json",
  "title": "Front Door Runtime Topology Contract",
  "description": "Schema for the parent front-door topology that keeps the governance triad separate from runtime roles while defining conversation, inbox, review, and delegated execution lanes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "scope",
    "governance_layer",
    "runtime_layer",
    "ingress_lanes",
    "mode_truth",
    "separation_rules",
    "observability_and_policy"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "contract_id": {
      "type": "string",
      "const": "parent-front-door-runtime-topology"
    },
    "scope": {
      "type": "string",
      "const": "portable_parent_wrapper"
    },
    "governance_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triad_topology_ref",
        "triad_roles",
        "governance_only"
      ],
      "properties": {
        "triad_topology_ref": {
          "type": "string",
          "const": "contracts/three-agent-topology.yaml"
        },
        "triad_roles": {
          "$ref": "#/$defs/triadRoles"
        },
        "governance_only": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "runtime_layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_role_contract_ref",
        "inbox_packet_contract_ref",
        "runtime_roles",
        "role_aliasing_forbidden"
      ],
      "properties": {
        "runtime_role_contract_ref": {
          "type": "string",
          "const": "agent-heavy-run-prompt.schema.json"
        },
        "inbox_packet_contract_ref": {
          "type": "string",
          "const": "contracts/inbox-packet.yaml"
        },
        "runtime_roles": {
          "$ref": "#/$defs/runtimeRoles"
        },
        "role_aliasing_forbidden": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "ingress_lanes": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/ingressLane"
      },
      "allOf": [
        { "contains": { "type": "object", "properties": { "lane_id": { "const": "conversation_capture" } }, "required": ["lane_id"] } },
        { "contains": { "type": "object", "properties": { "lane_id": { "const": "governed_inbox" } }, "required": ["lane_id"] } },
        { "contains": { "type": "object", "properties": { "lane_id": { "const": "triad_review" } }, "required": ["lane_id"] } },
        { "contains": { "type": "object", "properties": { "lane_id": { "const": "routed_delegation" } }, "required": ["lane_id"] } }
      ]
    },
    "mode_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_mode",
        "same_host_bootstrap_ref",
        "same_host_runtime_impl_ref",
        "active_runtime_evidence_ref",
        "blocked_modes"
      ],
      "properties": {
        "active_mode": {
          "type": "string",
          "const": "same_host"
        },
        "same_host_bootstrap_ref": {
          "type": "string",
          "const": "scripts/watchers/inbox_router.py"
        },
        "same_host_runtime_impl_ref": {
          "type": "string",
          "const": "service/inbox_runtime.py"
        },
        "active_runtime_evidence_ref": {
          "type": "string",
          "const": "evaluation/tool-health/inbox-protocol/latest-scan.json"
        },
        "blocked_modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode_id",
              "blocker_or_dependency"
            ],
            "properties": {
              "mode_id": {
                "type": "string",
                "const": "cross_device"
              },
              "blocker_or_dependency": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "separation_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "governance_roles_cannot_originate_conversational_packets",
        "runtime_roles_cannot_self_promote_governance",
        "router_cannot_invent_missing_evidence",
        "triad_bypass_forbidden",
        "recursive_documentation_required",
        "explicit_packet_pairing_required"
      ],
      "properties": {
        "governance_roles_cannot_originate_conversational_packets": {
          "type": "boolean",
          "const": true
        },
        "runtime_roles_cannot_self_promote_governance": {
          "type": "boolean",
          "const": true
        },
        "router_cannot_invent_missing_evidence": {
          "type": "boolean",
          "const": true
        },
        "triad_bypass_forbidden": {
          "type": "boolean",
          "const": true
        },
        "recursive_documentation_required": {
          "type": "boolean",
          "const": true
        },
        "explicit_packet_pairing_required": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "observability_and_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routing_artifact_root",
        "service_entrypoint_ref",
        "app_entrypoint_ref",
        "recursive_documentation_contract_ref"
      ],
      "properties": {
        "routing_artifact_root": {
          "type": "string",
          "const": "evaluation/tool-health/inbox-protocol"
        },
        "service_entrypoint_ref": {
          "type": "string",
          "const": "service/main.py"
        },
        "app_entrypoint_ref": {
          "type": "string",
          "const": "app/server.ts"
        },
        "recursive_documentation_contract_ref": {
          "type": "string",
          "const": "contracts/recursive-documentation-bundle.yaml"
        }
      }
    }
  },
  "$defs": {
    "triadRoles": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 3,
      "items": {
        "type": "string",
        "enum": [
          "orchestrator-validator",
          "research",
          "architect"
        ]
      }
    },
    "runtimeRoles": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 6,
      "items": {
        "type": "string",
        "enum": [
          "user-facing-agent",
          "spec-interpreter",
          "filesystem-router",
          "intake-mapper",
          "semantic-cartographer",
          "wrapper-synthesizer"
        ]
      }
    },
    "ingressLane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_id",
        "owned_by_plane",
        "entry_artifact_contract",
        "downstream_contracts",
        "target_roles"
      ],
      "properties": {
        "lane_id": {
          "type": "string",
          "enum": [
            "conversation_capture",
            "governed_inbox",
            "triad_review",
            "routed_delegation"
          ]
        },
        "owned_by_plane": {
          "type": "string",
          "enum": [
            "runtime",
            "bridge",
            "governance"
          ]
        },
        "entry_artifact_contract": {
          "type": "string",
          "minLength": 1
        },
        "downstream_contracts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target_roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
