{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fre-meta-harness/schemas/compiled-capability-harvest.schema.json",
  "title": "Compiled Capability Harvest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_type",
    "status",
    "capabilities",
    "exact_blockers",
    "compiler_notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "packet_type": {
      "type": "string",
      "enum": ["capability_harvest", "compiled_capability_harvest"]
    },
    "status": {
      "type": "string",
      "enum": ["fresh", "refreshed"]
    },
    "generated_at": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/capabilityRow"
      }
    },
    "exact_blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exactBlocker"
      }
    },
    "compiler_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "repo_packets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^evaluation/research/repos/.+\\.json$"
      }
    },
    "topic_packets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^evaluation/research/topics/.+\\.json$"
      }
    },
    "topic_summaries": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "classification": {
      "type": "string",
      "enum": [
        "core",
        "gated",
        "deployment_specific",
        "reference",
        "blocked_with_exact_dependency"
      ]
    },
    "proofState": {
      "type": "string",
      "enum": [
        "designed_not_activated",
        "bounded_probe_blocked",
        "bounded_probe_pass",
        "activation_proven_same_host"
      ]
    },
    "surfaceType": {
      "type": "string",
      "enum": [
        "communication_plane",
        "distribution_plane",
        "policy_plane",
        "observability_plane",
        "arbitration_lane",
        "sandbox_execution",
        "browser_validation",
        "device_sidecar",
        "parallel_branching_reference",
        "loop_pattern_reference"
      ]
    },
    "capabilityRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "upstream_repo",
        "parent_surface_type",
        "parent_lane_classification",
        "installation_state",
        "proof_state"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_\\-]+$"
        },
        "upstream_repo": {
          "type": "string",
          "minLength": 5
        },
        "parent_surface_type": {
          "$ref": "#/$defs/surfaceType"
        },
        "parent_lane_classification": {
          "$ref": "#/$defs/classification"
        },
        "installation_state": {
          "type": "string",
          "enum": ["installed", "not_installed", "partial"]
        },
        "proof_state": {
          "$ref": "#/$defs/proofState"
        },
        "lib_path": {
          "type": ["string", "null"]
        },
        "install_method": {
          "type": ["string", "null"]
        },
        "blocker": {
          "type": ["string", "null"]
        },
        "upstream_feature_name": {
          "type": "string"
        },
        "target_contract_surface": {
          "type": "string"
        },
        "runtime_trigger": {
          "type": "string"
        },
        "runtime_actor": {
          "type": "string"
        },
        "validation_method": {
          "type": "string"
        },
        "evidence_artifact": {
          "type": "string"
        },
        "blocker_or_dependency": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "exactBlocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_\\-]+$"
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "blocker_or_dependency": {
          "type": "string",
          "minLength": 10
        },
        "blocker_type": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      }
    }
  }
}
