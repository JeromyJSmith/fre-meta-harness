{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fre-meta-harness/schemas/gap-placement-map.schema.json",
  "title": "Gap Placement Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_type",
    "status",
    "lanes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "packet_type": {
      "type": "string",
      "enum": ["gap_placement_map", "compiled_gap_placement_map"]
    },
    "status": {
      "type": "string",
      "enum": ["fresh", "refreshed"]
    },
    "generated_at": {
      "type": "string"
    },
    "lanes": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "summary": {
      "type": "object"
    },
    "compiler_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "classification": {
      "type": "string",
      "enum": [
        "core",
        "gated",
        "deployment_specific",
        "reference",
        "blocked_with_exact_dependency"
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "parent_lane_classification"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_\\-]+$"
        },
        "parent_lane_classification": {
          "$ref": "#/$defs/classification"
        },
        "target_contract_surface": {
          "type": "string"
        },
        "required_for_harvest": {
          "type": "boolean"
        },
        "fulfills_contracts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gap_status": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "lane_id": {
          "type": "string"
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "driver_repos": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "target_surfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "why": {
          "type": "string"
        },
        "blocker_or_dependency": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
