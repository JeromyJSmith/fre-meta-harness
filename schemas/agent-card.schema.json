{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fre-meta-harness/schemas/agent-card.schema.json",
  "title": "Agent Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "agent_id",
    "tool_id",
    "name",
    "description",
    "owner",
    "discovery",
    "capabilities",
    "input_modalities",
    "output_artifact_types",
    "task_endpoints",
    "policy_modes",
    "observability_contract_ref"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "agent_card"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "tool_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "owner": {
      "type": "string",
      "minLength": 3
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "method",
        "returned_artifact_type"
      ],
      "properties": {
        "path": {
          "type": "string",
          "const": "/.well-known/agent.json"
        },
        "method": {
          "type": "string",
          "const": "GET"
        },
        "returned_artifact_type": {
          "type": "string",
          "const": "agent_card"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^CAP-\\d{4}$"
      }
    },
    "input_modalities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "json",
          "markdown",
          "path_refs"
        ]
      }
    },
    "output_artifact_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "task_endpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "status",
        "artifacts"
      ],
      "properties": {
        "create": {
          "type": "string",
          "const": "/v1/tools/{toolId}/tasks"
        },
        "status": {
          "type": "string",
          "const": "/v1/tasks/{taskId}"
        },
        "artifacts": {
          "type": "string",
          "const": "/v1/tasks/{taskId}/artifacts"
        }
      }
    },
    "policy_modes": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "allow",
          "block",
          "ask"
        ]
      },
      "allOf": [
        { "contains": { "const": "allow" } },
        { "contains": { "const": "block" } },
        { "contains": { "const": "ask" } }
      ]
    },
    "observability_contract_ref": {
      "type": "string",
      "const": "contracts/observability-ingest.yaml"
    }
  }
}
