{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fre-meta-harness/schemas/tool-task.schema.json",
  "title": "Tool Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "task_id",
    "tool_id",
    "agent_id",
    "status",
    "created_at",
    "updated_at",
    "request",
    "execution",
    "artifacts",
    "storage"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "tool_task"
    },
    "task_id": {
      "type": "string",
      "pattern": "^task-[a-z0-9-]+$"
    },
    "tool_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "blocked",
        "cancelled"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_artifact_refs",
        "requested_by",
        "correlation_id"
      ],
      "properties": {
        "input_artifact_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "requested_by": {
          "type": "string",
          "minLength": 3
        },
        "correlation_id": {
          "type": "string",
          "pattern": "^[A-Z0-9-]{6,}$"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create_endpoint",
        "status_endpoint",
        "artifacts_endpoint",
        "decision_mode",
        "completion_signal"
      ],
      "properties": {
        "create_endpoint": {
          "type": "string",
          "const": "/v1/tools/{toolId}/tasks"
        },
        "status_endpoint": {
          "type": "string",
          "const": "/v1/tasks/{taskId}"
        },
        "artifacts_endpoint": {
          "type": "string",
          "const": "/v1/tasks/{taskId}/artifacts"
        },
        "decision_mode": {
          "type": "string",
          "enum": [
            "allow",
            "ask",
            "block"
          ]
        },
        "completion_signal": {
          "type": "string",
          "enum": [
            "artifact_emitted",
            "exact_blocker",
            "terminal_failure"
          ]
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_artifact_refs"
      ],
      "properties": {
        "output_artifact_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_table",
        "pixeltable_sync_status"
      ],
      "properties": {
        "registry_table": {
          "type": "string",
          "const": "tasks"
        },
        "pixeltable_sync_status": {
          "type": "string",
          "const": "blocked_not_activated"
        }
      }
    }
  }
}
