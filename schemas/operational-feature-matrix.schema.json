{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fre-meta-harness/schemas/operational-feature-matrix.schema.json",
  "title": "Operational Feature Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_type",
    "status",
    "rows"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "packet_type": {
      "type": "string",
      "const": "operational_feature_matrix"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "refreshed"
      ]
    },
    "rows": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "$defs": {
    "classification": {
      "type": "string",
      "enum": [
        "core",
        "gated",
        "deployment_specific",
        "reference",
        "blocked_with_exact_dependency"
      ]
    },
    "surfaceType": {
      "type": "string",
      "enum": [
        "communication_plane",
        "distribution_plane",
        "policy_plane",
        "observability_plane",
        "arbitration_lane",
        "browser_validation",
        "sandbox_execution",
        "device_sidecar"
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "feature_area",
        "parent_surface_type",
        "target_contract_surface",
        "runtime_trigger",
        "runtime_actor",
        "validation_method",
        "evidence_artifact",
        "blocker_or_dependency",
        "parent_lane_classification",
        "consume_inputs",
        "compiled_outputs",
        "do_not_promote_notes"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_\\-]+$"
        },
        "feature_area": {
          "type": "string",
          "minLength": 3
        },
        "parent_surface_type": {
          "$ref": "#/$defs/surfaceType"
        },
        "target_contract_surface": {
          "type": "string",
          "minLength": 3
        },
        "runtime_trigger": {
          "type": "string",
          "minLength": 3
        },
        "runtime_actor": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_\\-]+$"
        },
        "validation_method": {
          "type": "string",
          "minLength": 20
        },
        "evidence_artifact": {
          "type": "string",
          "minLength": 3
        },
        "blocker_or_dependency": {
          "type": "string",
          "minLength": 20
        },
        "parent_lane_classification": {
          "$ref": "#/$defs/classification"
        },
        "consume_inputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^inbox/.+"
          }
        },
        "compiled_outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(evaluation|outbox)/.+"
          }
        },
        "do_not_promote_notes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  }
}
