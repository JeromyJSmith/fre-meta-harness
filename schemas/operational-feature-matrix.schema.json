{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fre-meta-harness/schemas/operational-feature-matrix.schema.json",
  "title": "Operational Feature Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_type",
    "status",
    "rows"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "packet_type": {
      "type": "string",
      "enum": ["operational_feature_matrix", "compiled_operational_feature_matrix"]
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "fresh", "refreshed"]
    },
    "generated_at": {
      "type": "string"
    },
    "filter": {
      "type": ["object", "string"]
    },
    "surface_type_columns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "object"
    },
    "compiler_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "rows": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "$defs": {
    "classification": {
      "type": "string",
      "enum": [
        "core",
        "gated",
        "deployment_specific",
        "reference",
        "blocked_with_exact_dependency"
      ]
    },
    "proofState": {
      "type": "string",
      "enum": [
        "designed_not_activated",
        "bounded_probe_blocked",
        "bounded_probe_pass",
        "activation_proven_same_host"
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "parent_lane_classification"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_\\-]+$"
        },
        "parent_lane_classification": {
          "$ref": "#/$defs/classification"
        },
        "installation_state": {
          "type": "string",
          "enum": ["installed", "not_installed", "partial"]
        },
        "proof_state": {
          "$ref": "#/$defs/proofState"
        },
        "communication_plane": {
          "type": "string"
        },
        "distribution_plane": {
          "type": "string"
        },
        "policy_plane": {
          "type": "string"
        },
        "observability_plane": {
          "type": "string"
        },
        "arbitration_lane": {
          "type": "string"
        },
        "sandbox_execution": {
          "type": "string"
        },
        "browser_validation": {
          "type": "string"
        },
        "device_sidecar": {
          "type": "string"
        },
        "parallel_branching_reference": {
          "type": "string"
        },
        "loop_pattern_reference": {
          "type": "string"
        },
        "feature_area": {
          "type": "string"
        },
        "parent_surface_type": {
          "type": "string"
        },
        "target_contract_surface": {
          "type": "string"
        },
        "runtime_trigger": {
          "type": "string"
        },
        "runtime_actor": {
          "type": "string"
        },
        "validation_method": {
          "type": "string"
        },
        "evidence_artifact": {
          "type": "string"
        },
        "blocker_or_dependency": {
          "type": "string"
        },
        "consume_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "compiled_outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "do_not_promote_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
