{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fre-meta-harness/schemas/evidence-strength.schema.json",
  "title": "Evidence Strength",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_ref",
    "evidence_type",
    "strength_class",
    "transcript_derived",
    "workflow_claim_promotion",
    "notes"
  ],
  "properties": {
    "source_ref": {
      "type": "string",
      "minLength": 3
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "local_authority",
        "transcript_context_summary",
        "repo_doc",
        "repo_runtime_entrypoint",
        "repo_manifest",
        "skill_runtime",
        "local_gap_placeholder",
        "task_capture",
        "local_registry",
        "task_stub",
        "parent_contract",
        "first_party_consume_packet",
        "compiled_derivative"
      ]
    },
    "strength_class": {
      "type": "string",
      "enum": [
        "structural_placeholder",
        "documentary_support",
        "transcript_context_limited",
        "task_capture_limited",
        "task_stub_limited",
        "first_party_packet",
        "compiled_derivative",
        "terminal_or_frame_verified"
      ]
    },
    "transcript_derived": {
      "type": "boolean"
    },
    "workflow_claim_promotion": {
      "type": "string",
      "enum": [
        "allowed",
        "blocked"
      ]
    },
    "required_artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "do_not_promote_reason": {
      "type": "string",
      "minLength": 10
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "transcript_derived": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "do_not_promote_reason"
        ],
        "properties": {
          "workflow_claim_promotion": {
            "const": "blocked"
          },
          "strength_class": {
            "enum": [
              "transcript_context_limited",
              "task_capture_limited",
              "task_stub_limited"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "strength_class": {
            "const": "terminal_or_frame_verified"
          }
        }
      },
      "then": {
        "properties": {
          "workflow_claim_promotion": {
            "const": "allowed"
          }
        }
      }
    }
  ]
}
