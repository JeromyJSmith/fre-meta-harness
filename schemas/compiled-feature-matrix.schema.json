{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fre-meta-harness/schemas/compiled-feature-matrix.schema.json",
  "title": "Compiled Feature Matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_type",
    "status",
    "rows"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "packet_type": {
      "type": "string",
      "enum": ["feature_matrix", "compiled_feature_matrix"]
    },
    "status": {
      "type": "string",
      "enum": ["fresh", "refreshed"]
    },
    "generated_at": {
      "type": "string"
    },
    "surface_type_columns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compiler_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "rows": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/matrixRow"
      }
    }
  },
  "$defs": {
    "classification": {
      "type": "string",
      "enum": [
        "core",
        "gated",
        "deployment_specific",
        "reference",
        "blocked_with_exact_dependency"
      ]
    },
    "surfaceType": {
      "type": "string",
      "enum": [
        "communication_plane",
        "distribution_plane",
        "policy_plane",
        "observability_plane",
        "arbitration_lane",
        "sandbox_execution",
        "browser_validation",
        "device_sidecar",
        "parallel_branching_reference",
        "loop_pattern_reference"
      ]
    },
    "matrixRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "parent_lane_classification"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_\\-]+$"
        },
        "parent_lane_classification": {
          "$ref": "#/$defs/classification"
        },
        "installation_state": {
          "type": "string",
          "enum": ["installed", "not_installed", "partial"]
        },
        "communication_plane": {
          "type": "string"
        },
        "distribution_plane": {
          "type": "string"
        },
        "policy_plane": {
          "type": "string"
        },
        "observability_plane": {
          "type": "string"
        },
        "arbitration_lane": {
          "type": "string"
        },
        "sandbox_execution": {
          "type": "string"
        },
        "browser_validation": {
          "type": "string"
        },
        "device_sidecar": {
          "type": "string"
        },
        "parallel_branching_reference": {
          "type": "string"
        },
        "loop_pattern_reference": {
          "type": "string"
        },
        "upstream_repo": {
          "type": "string"
        },
        "upstream_feature_name": {
          "type": "string"
        },
        "parent_surface_type": {
          "$ref": "#/$defs/surfaceType"
        },
        "target_contract_surface": {
          "type": "string"
        },
        "runtime_trigger": {
          "type": "string"
        },
        "runtime_actor": {
          "type": "string"
        },
        "validation_method": {
          "type": "string"
        },
        "evidence_artifact": {
          "type": "string"
        },
        "blocker_or_dependency": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
