{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fre-meta-harness/schemas/consume-source-quality-strengthening-report.schema.json",
  "title": "Consume Source Quality Strengthening Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_id",
    "status",
    "selected_workflow_strengthening_slice",
    "decision_space",
    "recommended_option_id",
    "iteration_count",
    "iteration_score_history",
    "operational_feature_matrix_artifact_path",
    "capability_matrix_extension_artifact_path",
    "consume_folder_extraction_map_artifact_path",
    "compiled_output_ingestion_map",
    "schema_additions",
    "files_changed",
    "targeted_validation_results",
    "runtime_truth",
    "blockers",
    "freshness",
    "score_saturation",
    "command_evidence",
    "follow_up_prompt"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "pattern": "^CSQ-[0-9]{8}-[A-Z0-9]{4,}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "blocked"
      ]
    },
    "selected_workflow_strengthening_slice": {
      "type": "string",
      "const": "consume_source_quality"
    },
    "decision_space": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/decisionOption"
      }
    },
    "recommended_option_id": {
      "type": "string",
      "pattern": "^option-[a-z]$"
    },
    "iteration_count": {
      "type": "integer",
      "minimum": 1
    },
    "iteration_score_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/iterationScore"
      }
    },
    "operational_feature_matrix_artifact_path": {
      "type": "string",
      "pattern": "^evaluation/.+\\.json$"
    },
    "capability_matrix_extension_artifact_path": {
      "type": "string",
      "pattern": "^outbox/.+\\.md$"
    },
    "consume_folder_extraction_map_artifact_path": {
      "type": "string",
      "pattern": "^outbox/.+\\.md$"
    },
    "compiled_output_ingestion_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/$defs/ingestionEntry"
          }
        }
      }
    },
    "schema_additions": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^schemas/.+\\.json$"
      }
    },
    "files_changed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "targeted_validation_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/validationResult"
      }
    },
    "runtime_truth": {
      "$ref": "#/$defs/runtimeTruth"
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "freshness": {
      "$ref": "#/$defs/freshness"
    },
    "score_saturation": {
      "$ref": "#/$defs/scoreSaturation"
    },
    "command_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation_commands",
        "schema_validation_commands",
        "compile_commands",
        "tool_health_commands",
        "infranodus_commands",
        "research_commands_or_reads"
      ],
      "properties": {
        "validation_commands": {
          "$ref": "#/$defs/stringList"
        },
        "schema_validation_commands": {
          "$ref": "#/$defs/stringList"
        },
        "compile_commands": {
          "$ref": "#/$defs/stringList"
        },
        "tool_health_commands": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "infranodus_commands": {
          "$ref": "#/$defs/stringList"
        },
        "research_commands_or_reads": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "follow_up_prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_path",
        "target_schema_ref",
        "target_template_ref",
        "must_be_inline_ready",
        "markdown_companion_artifact_path",
        "markdown_template_ref",
        "must_use_front_matter",
        "must_use_bottom_matter_marker"
      ],
      "properties": {
        "artifact_path": {
          "type": "string",
          "minLength": 3
        },
        "target_schema_ref": {
          "type": "string",
          "const": "agent-heavy-run-prompt.schema.json"
        },
        "target_template_ref": {
          "type": "string",
          "const": "agent-heavy-run-prompt.template.yaml"
        },
        "must_be_inline_ready": {
          "type": "boolean",
          "const": true
        },
        "markdown_companion_artifact_path": {
          "type": "string",
          "minLength": 3
        },
        "markdown_template_ref": {
          "type": "string",
          "const": "prompts/governed-triad-follow-up-prompt.template.md"
        },
        "must_use_front_matter": {
          "type": "boolean",
          "const": true
        },
        "must_use_bottom_matter_marker": {
          "type": "boolean",
          "const": true
        }
      }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "decisionOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "option_id",
        "title",
        "why_now",
        "evidence_refs"
      ],
      "properties": {
        "option_id": {
          "type": "string",
          "pattern": "^option-[a-z]$"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "why_now": {
          "type": "string",
          "minLength": 10
        },
        "evidence_refs": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "iterationScore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iteration",
        "summary",
        "before_total_score",
        "after_total_score",
        "score_changed"
      ],
      "properties": {
        "iteration": {
          "type": "integer",
          "minimum": 1
        },
        "summary": {
          "type": "string",
          "minLength": 3
        },
        "before_total_score": {
          "type": "number"
        },
        "after_total_score": {
          "type": "number"
        },
        "score_changed": {
          "type": "boolean"
        }
      }
    },
    "validationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 3
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "blocked"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "ingestionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiled_output",
        "source_inputs",
        "ingestion_rule",
        "policy_gate",
        "evidence_refs"
      ],
      "properties": {
        "compiled_output": {
          "type": "string",
          "minLength": 3
        },
        "source_inputs": {
          "$ref": "#/$defs/stringList"
        },
        "ingestion_rule": {
          "type": "string",
          "minLength": 10
        },
        "policy_gate": {
          "type": "string",
          "minLength": 10
        },
        "evidence_refs": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_id",
        "classification",
        "blocker_dependency",
        "missing_prerequisites",
        "evidence_refs"
      ],
      "properties": {
        "lane_id": {
          "type": "string",
          "minLength": 3
        },
        "classification": {
          "type": "string",
          "minLength": 3
        },
        "blocker_dependency": {
          "type": "string",
          "minLength": 10
        },
        "missing_prerequisites": {
          "$ref": "#/$defs/stringList"
        },
        "evidence_refs": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "runtimeTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_truth_level",
        "active_parent_runtime_lanes",
        "blocked_parent_runtime_lanes",
        "activation_artifacts_used",
        "non_activated_subsystem_lanes",
        "do_not_overclaim_notes"
      ],
      "properties": {
        "runtime_truth_level": {
          "type": "string",
          "enum": [
            "contract_only",
            "bounded_runtime",
            "active_runtime"
          ]
        },
        "active_parent_runtime_lanes": {
          "$ref": "#/$defs/stringList"
        },
        "blocked_parent_runtime_lanes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lane_id",
              "classification",
              "blocker_dependency",
              "evidence_refs"
            ],
            "properties": {
              "lane_id": {
                "type": "string",
                "minLength": 3
              },
              "classification": {
                "type": "string",
                "minLength": 3
              },
              "blocker_dependency": {
                "type": "string",
                "minLength": 10
              },
              "evidence_refs": {
                "$ref": "#/$defs/stringList"
              }
            }
          }
        },
        "activation_artifacts_used": {
          "$ref": "#/$defs/stringList"
        },
        "non_activated_subsystem_lanes": {
          "$ref": "#/$defs/stringList"
        },
        "do_not_overclaim_notes": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_records",
        "max_artifact_span_seconds",
        "tool_health_artifacts",
        "compiled_research_artifacts",
        "infranodus_artifacts"
      ],
      "properties": {
        "artifact_records": {
          "$ref": "#/$defs/stringList"
        },
        "max_artifact_span_seconds": {
          "type": "number",
          "minimum": 0
        },
        "tool_health_artifacts": {
          "$ref": "#/$defs/stringList"
        },
        "compiled_research_artifacts": {
          "$ref": "#/$defs/stringList"
        },
        "infranodus_artifacts": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "scoreSaturation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_total_score",
        "final_total_score",
        "score_changed",
        "why_this_slice_counts"
      ],
      "properties": {
        "baseline_total_score": {
          "type": "number"
        },
        "final_total_score": {
          "type": "number"
        },
        "score_changed": {
          "type": "boolean"
        },
        "why_this_slice_counts": {
          "type": "string",
          "minLength": 10
        }
      }
    }
  }
}
