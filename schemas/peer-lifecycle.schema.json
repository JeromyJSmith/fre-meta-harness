{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fre-meta-harness/schemas/peer-lifecycle.schema.json",
  "title": "Parent Peer Lifecycle Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "scope",
    "states",
    "transitions",
    "event_contracts",
    "completion_boundary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "contract_id": {
      "type": "string",
      "const": "parent-peer-lifecycle"
    },
    "scope": {
      "type": "string",
      "const": "portable_parent_wrapper"
    },
    "states": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/state"
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "event_contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatch_event",
        "response_event",
        "retry_event",
        "escalation_event"
      ],
      "properties": {
        "dispatch_event": {
          "type": "string",
          "const": "message_dispatch"
        },
        "response_event": {
          "type": "string",
          "const": "response_received"
        },
        "retry_event": {
          "type": "string",
          "const": "retry_requested"
        },
        "escalation_event": {
          "type": "string",
          "const": "needs_human"
        }
      }
    },
    "completion_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_event_types",
        "terminal_states",
        "retryable_states",
        "verification_role_classes",
        "runtime_contract"
      ],
      "properties": {
        "required_event_types": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_\\-]+$"
          }
        },
        "terminal_states": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_\\-]+$"
          }
        },
        "retryable_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_\\-]+$"
          }
        },
        "verification_role_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          },
          "allOf": [
            { "contains": { "const": "verification_guard" } }
          ]
        },
        "runtime_contract": {
          "type": "string",
          "const": "contracts/peer-mesh-runtime.yaml"
        }
      }
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_id",
        "purpose"
      ],
      "properties": {
        "state_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_\\-]+$"
        },
        "purpose": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_state",
        "on_event",
        "to_state"
      ],
      "properties": {
        "from_state": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_\\-]+$"
        },
        "on_event": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_\\-]+$"
        },
        "to_state": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_\\-]+$"
        }
      }
    }
  }
}
