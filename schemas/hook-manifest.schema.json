{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fre-meta-harness/schemas/hook-manifest.schema.json",
  "title": "Parent Hook Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "scope",
    "policy",
    "policy_contracts",
    "hooks"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "contract_id": {
      "type": "string",
      "const": "parent-hook-manifest"
    },
    "scope": {
      "type": "string",
      "const": "portable_parent_wrapper"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fail_mode",
        "require_evidence_artifact",
        "require_verification_boundary"
      ],
      "properties": {
        "fail_mode": {
          "type": "string",
          "const": "fail_loud"
        },
        "require_evidence_artifact": {
          "type": "boolean",
          "const": true
        },
        "require_verification_boundary": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "hooks": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/hook"
      }
    },
    "policy_contracts": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  },
  "$defs": {
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hook_id",
        "hook_class",
        "event",
        "description",
        "runtime_trigger",
        "runtime_actor",
        "required_capabilities",
        "target_contract_surfaces",
        "governed_operations",
        "policy_outcomes",
        "validation_method",
        "evidence_artifact",
        "on_failure"
      ],
      "properties": {
        "hook_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_\\-]+$"
        },
        "hook_class": {
          "type": "string",
          "minLength": 3
        },
        "event": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_\\-]+$"
        },
        "description": {
          "type": "string",
          "minLength": 20
        },
        "runtime_trigger": {
          "type": "string",
          "minLength": 3
        },
        "runtime_actor": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_\\-]+$"
        },
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "target_contract_surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "governed_operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_\\-]+$"
          }
        },
        "policy_outcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["allow", "block", "ask"]
          }
        },
        "validation_method": {
          "type": "string",
          "minLength": 20
        },
        "evidence_artifact": {
          "type": "string",
          "minLength": 3
        },
        "on_failure": {
          "type": "string",
          "const": "fail_loud"
        }
      }
    }
  }
}
